mapscripts SaintFrancois_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_SF_AQUA_REMATCH)) {
            call(SaintFrancois_Setup_Rematch)
        } elif (flag(FLAG_HIDE_AQUA_SF)) {
            # Rüpel sind schon besiegt, Zwischensequenz nicht erneut starten
            setvar(VAR_TEMP_0, 1)
        }
    }
}

script SaintFrancois_Aqua_Fight {
    lockall
    msgbox(format("GRUNT: This is not a request. You need to take us to ISLAND, and we're not here to discuss it."))
    msgbox(format("MOTHER: Even if I wanted to, I couldn't. The sea is too rough these days. It will take some time until the boat can leave the harbor again."))
    msgbox(format("GRUNT: LIES! I don't believe you. Either you take us there voluntarily, or we'll make you drive the boat!"))

    playse(SE_PIN)
    applymovement(LOCALID_AQUA_GIRL_SF, Girl_Sees_Prot_SF)
    applymovement(LOCALID_AQUA_GUY_SF, Guy_Sees_Prot_SF)
    waitmovement(LOCALID_AQUA_GIRL_SF)
    waitmovement(LOCALID_AQUA_GUY_SF)

    msgbox(format("GRUNT: What are you doing here? Get lost!"))
    msgbox(format("MOTHER: {PLAYER}! Please help me, these people want to force me to take them to ISLAND!"))

    # Rivale kommt, je nach Spielerposition
    clearflag(FLAG_HIDE_RIVAL_SF)
    addobject(LOCALID_RIVAL_SF)
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    switch (var(VAR_TEMP_0)) {
        case 29:
            applymovement(LOCALID_RIVAL_SF, Rival_Arrives_SF_23)
        default:
            applymovement(LOCALID_RIVAL_SF, Rival_Arrives_SF_24)
    }
    waitmovement(LOCALID_RIVAL_SF)

    msgbox(format("RIVAL: What's going on here? Leave {PLAYER}'s mother alone!"))
    msgbox(format("GRUNT: Ugh, you kids keep annoying me. I've talked enough, let's fight!"))

    # Grunts gehen nach oben, je nach Spielerposition
    if (var(VAR_TEMP_0) == 30) {
        applymovement(LOCALID_AQUA_GIRL_SF, Girl_Goes_Up_SF_30)
        applymovement(LOCALID_AQUA_GUY_SF, Guy_Goes_Up_SF_30)
    } else {
        applymovement(LOCALID_AQUA_GIRL_SF, Grunt_Goes_Up_SF)
        applymovement(LOCALID_AQUA_GUY_SF, Grunt_Goes_Up_SF)
    }
    waitmovement(LOCALID_AQUA_GIRL_SF)
    waitmovement(LOCALID_AQUA_GUY_SF)

    goto(SaintFrancois_Aqua_Battle)
}

# Doppelkampf: Spieler + Rivale gegen die beiden Rüpel.
# Bei einer Niederlage bleibt FLAG_SF_AQUA_REMATCH gesetzt, dann stehen die
# Rüpel beim nächsten Betreten der Map in Kampfstellung und warten.
script SaintFrancois_Aqua_Battle {
    setflag(FLAG_SF_AQUA_REMATCH)
    call(SaintFrancois_Aqua_Multi_Battle)
    if (var(VAR_RESULT) != B_OUTCOME_WON) {
        fadescreen(FADE_TO_BLACK)
        special(SetCB2WhiteOut)
        end
    }
    clearflag(FLAG_SF_AQUA_REMATCH)
    # Doppelkampf gewonnen, jetzt kann man mit der Mutter reden
    setvar(VAR_STORY_PROGRESS, 4)

    msgbox(format("GRUNT: Tch! We'll be back, you brats! Retreat!"))
    closemessage
    applymovement(LOCALID_AQUA_GIRL_SF, Grunt_Runs_Away_SF)
    applymovement(LOCALID_AQUA_GUY_SF, Grunt_Runs_Away_SF)
    waitmovement(LOCALID_AQUA_GIRL_SF)
    waitmovement(LOCALID_AQUA_GUY_SF)
    setflag(FLAG_HIDE_AQUA_SF)
    removeobject(LOCALID_AQUA_GIRL_SF)
    removeobject(LOCALID_AQUA_GUY_SF)
    # Rüpel am Höhleneingang auf Route 1 verschwindet auch
    setflag(FLAG_HIDE_AQUA_BLOCK_SF)

    applymovement(LOCALID_RIVAL_SF, Common_Movement_FacePlayer)
    waitmovement(LOCALID_RIVAL_SF)
    msgbox(format("RIVAL: Phew, we showed them! I'll go ahead to Le Moule. Meet me there, {PLAYER}!"))
    closemessage
    applymovement(LOCALID_RIVAL_SF, Rival_Leaves_SF)
    waitmovement(LOCALID_RIVAL_SF)
    setflag(FLAG_HIDE_RIVAL_SF)
    removeobject(LOCALID_RIVAL_SF)
    releaseall
}

movement Grunt_Runs_Away_SF {
    walk_fast_down * 2
    walk_fast_left * 10
}

movement Rival_Leaves_SF {
    walk_up * 2
    walk_left * 10
}

# Rüpel und Rivale auf ihre Positionen nach der Zwischensequenz setzen und
# den Trigger der Zwischensequenz abschalten
script SaintFrancois_Setup_Rematch {
    setvar(VAR_TEMP_0, 1)
    setobjectxyperm(LOCALID_AQUA_GIRL_SF, 28, 33)
    setobjectmovementtype(LOCALID_AQUA_GIRL_SF, MOVEMENT_TYPE_FACE_UP)
    setobjectxyperm(LOCALID_AQUA_GUY_SF, 29, 33)
    setobjectmovementtype(LOCALID_AQUA_GUY_SF, MOVEMENT_TYPE_FACE_UP)
    clearflag(FLAG_HIDE_RIVAL_SF)
    setobjectxyperm(LOCALID_RIVAL_SF, 27, 33)
    setobjectmovementtype(LOCALID_RIVAL_SF, MOVEMENT_TYPE_FACE_UP)
}

# Nach dem Doppelkampf (Story 4) gibt die Mutter das Paket für den Professor
# und 5 Pokebälle, danach (Story 5+) nur noch Standardtext.
script SaintFrancois_Mother_Talk {
    lock
    faceplayer
    if (var(VAR_STORY_PROGRESS) == 4) {
        msgbox(format("MOTHER: {PLAYER}, thank you so much for helping me! Oh, before I forget: this parcel arrived for the professor. Could you bring it to him?"))
        giveitem(ITEM_PARCEL)
        msgbox(format("MOTHER: And take these POKé BALLS. With them you can catch your very first POKéMON yourself on your way home!"))
        giveitem(ITEM_POKE_BALL, 5)
        setvar(VAR_STORY_PROGRESS, 5)
    } elif (var(VAR_STORY_PROGRESS) >= 5) {
        msgbox(format("MOTHER: Hello {PLAYER}, how are you? The sea is still pretty stormy."))
    } else {
        msgbox(format("MOTHER: {PLAYER}, please help me!"))
    }
    release
}

script SaintFrancois_Aqua_Grunt_Talk {
    if (!flag(FLAG_SF_AQUA_REMATCH)) {
        end
    }
    lockall
    faceplayer
    msgbox(format("GRUNT: You again? Fine, this time we'll finish you off!"))
    closemessage
    goto(SaintFrancois_Aqua_Battle)
}

script SaintFrancois_Rival_Talk {
    if (!flag(FLAG_SF_AQUA_REMATCH)) {
        end
    }
    lock
    faceplayer
    msgbox(format("RIVAL: {PLAYER}! We can't let them get away with this. Let's try again!"))
    release
}

# Rivale hat das Starter-Pokemon aus dem Labor. Hat der Spieler dort verloren,
# wurden die Pokemon getauscht und der Rivale hat das ursprüngliche des Spielers.
script SaintFrancois_Aqua_Multi_Battle {
    if (defeated(TRAINER_RIVAL_LAB_CHARMANDER) || defeated(TRAINER_RIVAL_LAB_FROAKIE) || defeated(TRAINER_RIVAL_LAB_TREECKO)) {
        switch (var(VAR_STARTER_MON)) {
            case 0:
                goto(SaintFrancois_Aqua_Multi_Battle_Charmander)
            case 1:
                goto(SaintFrancois_Aqua_Multi_Battle_Froakie)
            case 2:
                goto(SaintFrancois_Aqua_Multi_Battle_Treecko)
        }
    } else {
        switch (var(VAR_STARTER_MON)) {
            case 0:
                goto(SaintFrancois_Aqua_Multi_Battle_Treecko)
            case 1:
                goto(SaintFrancois_Aqua_Multi_Battle_Charmander)
            case 2:
                goto(SaintFrancois_Aqua_Multi_Battle_Froakie)
        }
    }
    goto(SaintFrancois_Aqua_Multi_Battle_Treecko)
}

script SaintFrancois_Aqua_Multi_Battle_Treecko {
    multi_fixed_2_vs_2(TRAINER_SF_GRUNT_GIRL, SaintFrancois_Text_GruntGirlDefeat, TRAINER_SF_GRUNT_GUY, SaintFrancois_Text_GruntGuyDefeat, PARTNER_RIVAL_SF_TREECKO)
    return
}

script SaintFrancois_Aqua_Multi_Battle_Charmander {
    multi_fixed_2_vs_2(TRAINER_SF_GRUNT_GIRL, SaintFrancois_Text_GruntGirlDefeat, TRAINER_SF_GRUNT_GUY, SaintFrancois_Text_GruntGuyDefeat, PARTNER_RIVAL_SF_CHARMANDER)
    return
}

script SaintFrancois_Aqua_Multi_Battle_Froakie {
    multi_fixed_2_vs_2(TRAINER_SF_GRUNT_GIRL, SaintFrancois_Text_GruntGirlDefeat, TRAINER_SF_GRUNT_GUY, SaintFrancois_Text_GruntGuyDefeat, PARTNER_RIVAL_SF_FROAKIE)
    return
}

text SaintFrancois_Text_GruntGirlDefeat {
    format("No way! Beaten by a couple of kids?")
}

text SaintFrancois_Text_GruntGuyDefeat {
    format("Grr... This isn't over!")
}

movement Girl_Sees_Prot_SF {
    emote_exclamation_mark
}

movement Guy_Sees_Prot_SF {
    emote_exclamation_mark
    walk_left
    walk_up
}

movement Rival_Arrives_SF_23 {
    walk_right * 23
    walk_down
}

movement Rival_Arrives_SF_24 {
    walk_right * 24
    walk_down
}

movement Grunt_Goes_Up_SF {
    walk_up * 2
}

movement Girl_Goes_Up_SF_30 {
    walk_up * 2
    walk_right
    face_up
}

movement Guy_Goes_Up_SF_30 {
    walk_up
    walk_right
    walk_up
}